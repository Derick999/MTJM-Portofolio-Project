{
  "name": "mtjm-promo-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "node scripts/prepare-photos.mjs && remotion studio src/index.ts",
    "photos": "node scripts/prepare-photos.mjs",
    "render": "node scripts/prepare-photos.mjs && remotion render src/index.ts Promo-16x9 out/mtjm-promo.mp4 --codec=h264 --gl=angle --concurrency=3",
    "render:square": "node scripts/prepare-photos.mjs && remotion render src/index.ts Promo-1x1 out/mtjm-promo-square.mp4 --codec=h264 --gl=angle --concurrency=3",
    "still": "remotion still src/index.ts Promo-16x9 --gl=angle --concurrency=3"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.539",
    "@remotion/google-fonts": "^4.0.539",
    "@remotion/tailwind-v4": "4.0.539",
    "@remotion/three": "^4.0.539",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.539",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  }
}
